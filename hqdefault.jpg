<!-- <div><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Holi Confetti Rain</title>
  <style>
    #snow-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9999;
    }
    body {
      height: 500vh; /* Simulate a long page for scrolling */
    }
  </style>
</head>
<body>
<canvas id="snow-canvas"></canvas>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.getElementById("snow-canvas");
    const ctx = canvas.getContext("2d");

    function setCanvasSize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    setCanvasSize();
    window.addEventListener("resize", setCanvasSize);

    const colors = ['#FF0000', '#FF5733', '#FFBF00', '#33FF57', '#33CFFF', '#8A2BE2'];
    const confetti = [];
    const isDesktop = window.innerWidth > 768;
    const totalConfetti = 2;
    const maxSpeed = 1.5;
    const minSize = isDesktop ? 2 : 1;
    const maxDrift = 1;

    function createConfetti() {
      for (let i = 0; i < totalConfetti; i++) {
        confetti.push({
          x: Math.random() * canvas.width,
          y: Math.random() * 100,
          size: Math.random() * minSize + 1,
          speed: Math.random() * maxSpeed + 1,
          drift: Math.random() * maxDrift - maxDrift / 2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
    }

    let burstCount = 0;
    function createColorBurst() {
      let burstSize = burstCount === 0 ? 100 : 12;
      if (isDesktop && burstCount < 3 && burstCount !== 0) {
        burstSize = 24;
      }
      burstCount++;

      for (let i = 0; i < burstSize; i++) {
        confetti.push({
          x: Math.random() * canvas.width,
          y: Math.random() * 100,
          size: Math.random() * minSize + 1,
          speed: Math.random() * maxSpeed + 1,
          drift: Math.random() * maxDrift - maxDrift / 2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }

      setTimeout(createColorBurst, Math.random() * (8000 - 5000) + 5000);
    }

    function drawConfetti() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      confetti.forEach((particle) => {
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        ctx.fillStyle = particle.color;
        ctx.fill();
      });
      updateConfetti();
    }

    function updateConfetti() {
      confetti.forEach((particle) => {
        particle.y += particle.speed;
        particle.x += particle.drift;
        if (particle.y > canvas.height) {
          particle.y = Math.random() * 100;
        }
      });
    }

    let animationFrameId;
    function animateConfetti() {
      drawConfetti();
      animationFrameId = requestAnimationFrame(animateConfetti);
    }

    createConfetti();
    animateConfetti();
    createColorBurst();

    // Stop the animation after 30 seconds (30,000 ms)
    setTimeout(function() {
      let stopTime = Date.now() + 3000; // Time to slow down for 3 seconds

      function slowDown() {
        const currentTime = Date.now();
        const timeLeft = stopTime - currentTime;

        if (timeLeft > 0) {
          // Gradually slow down the speed of each confetti particle
          confetti.forEach(particle => {
            particle.speed *= 0.98;  // Slow down the speed
          });
          animationFrameId = requestAnimationFrame(slowDown); // Continue slowing down
        } else {
          // Once slowed down, stop the animation
          cancelAnimationFrame(animationFrameId);
          ctx.clearRect(0, 0, canvas.width, canvas.height); // Clear the canvas
        }
      }

      slowDown(); // Start the deceleration
    }, 30000); // 30 seconds before slowing down
  });
</script>

</body>
</html>
</div> -->
